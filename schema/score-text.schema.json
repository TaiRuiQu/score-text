{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Score Text v1",
  "description": "Agent-friendly YAML music notation. The parser additionally validates durations and cross-references.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "composer": {
      "type": "string"
    },
    "lyricist": {
      "type": "string"
    },
    "arranger": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "meter": {
      "type": "string",
      "pattern": "^([1-9]|[12][0-9]|3[0-2])/(1|2|4|8|16|32|64)$"
    },
    "tempo": {
      "$ref": "#/$defs/tempo"
    },
    "capo": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "fingering": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "tracks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-zA-Z][\\w-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/track"
      }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/bar"
      }
    },
    "chordShapes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "oneOf": [
            {
              "const": "x"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          ]
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/bar"
      }
    }
  },
  "required": [
    "version",
    "title",
    "tracks",
    "bars"
  ],
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ]
        },
        {
          "type": "string",
          "pattern": "^(1|2|4|8|16|32|64)\\.{0,2}(\\*[1-9][0-9]?:[1-9][0-9]?)?$"
        }
      ]
    },
    "tempo": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 10,
          "maximum": 400
        },
        {
          "type": "object",
          "properties": {
            "bpm": {
              "type": "number",
              "minimum": 10,
              "maximum": 400
            },
            "unit": {
              "$ref": "#/$defs/duration"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "bpm"
          ],
          "additionalProperties": false
        }
      ]
    },
    "lyrics": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "pitch": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          ]
        },
        "pitches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            ]
          }
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "rest": {
          "const": true
        },
        "strings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-6]$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "const": "x"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 36
              }
            ]
          }
        },
        "drums": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "kick",
              "snare",
              "hat",
              "openhat",
              "pedal",
              "crash",
              "ride",
              "tom1",
              "tom2",
              "floor"
            ]
          }
        },
        "strum": {
          "enum": [
            "down",
            "up",
            "mute"
          ]
        },
        "lyric": {
          "type": "string"
        },
        "tie": {
          "type": "boolean"
        },
        "slur": {
          "enum": [
            "start",
            "stop"
          ]
        },
        "dynamic": {
          "enum": [
            "ppp",
            "pp",
            "p",
            "mp",
            "mf",
            "f",
            "ff",
            "fff",
            "sfz"
          ]
        },
        "accent": {
          "type": "boolean"
        }
      },
      "required": [
        "duration"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "pitch"
          ]
        },
        {
          "required": [
            "pitches"
          ]
        },
        {
          "required": [
            "rest"
          ]
        },
        {
          "required": [
            "strings"
          ]
        },
        {
          "required": [
            "drums"
          ]
        },
        {
          "required": [
            "strum"
          ]
        }
      ]
    },
    "notes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/event"
              }
            ]
          }
        }
      ]
    },
    "voice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "staff": {
          "enum": [
            "main",
            "right",
            "left"
          ]
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "lyrics": {
          "$ref": "#/$defs/lyrics"
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false
    },
    "voiceInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/notes"
        },
        {
          "$ref": "#/$defs/voice"
        }
      ]
    },
    "trackBar": {
      "oneOf": [
        {
          "$ref": "#/$defs/voiceInput"
        },
        {
          "type": "object",
          "properties": {
            "right": {
              "$ref": "#/$defs/voiceInput"
            },
            "left": {
              "$ref": "#/$defs/voiceInput"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "voices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/voice"
              }
            }
          },
          "required": [
            "voices"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bar": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string"
        },
        "meter": {
          "type": "string",
          "pattern": "^([1-9]|[12][0-9]|3[0-2])/(1|2|4|8|16|32|64)$"
        },
        "key": {
          "type": "string"
        },
        "tempo": {
          "$ref": "#/$defs/tempo"
        },
        "tempoChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beat": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "bpm": {
                "type": "number",
                "minimum": 10,
                "maximum": 400
              },
              "unit": {
                "$ref": "#/$defs/duration"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "bpm"
            ],
            "additionalProperties": false
          }
        },
        "ramp": {
          "type": "object",
          "properties": {
            "to": {
              "type": "number",
              "minimum": 10,
              "maximum": 400
            },
            "bars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "to"
          ],
          "additionalProperties": false
        },
        "section": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "break": {
          "type": "boolean"
        },
        "pageBreak": {
          "type": "boolean"
        },
        "repeatStart": {
          "type": "boolean"
        },
        "repeatEnd": {
          "type": "boolean"
        },
        "final": {
          "type": "boolean"
        },
        "pickup": {
          "$ref": "#/$defs/duration"
        },
        "chords": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "beat": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "diagram": {
                        "type": "array",
                        "minItems": 6,
                        "maxItems": 6,
                        "items": {
                          "oneOf": [
                            {
                              "const": "x"
                            },
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 36
                            }
                          ]
                        }
                      },
                      "baseFret": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 24
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": {
        "$ref": "#/$defs/trackBar"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 400,
          "maximum": 3000
        },
        "height": {
          "type": "number",
          "minimum": 400,
          "maximum": 6000
        },
        "margin": {
          "type": "number",
          "minimum": 20,
          "maximum": 150
        },
        "barsPerSystem": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "systemGap": {
          "type": "number",
          "minimum": 15,
          "maximum": 150
        },
        "lyricSize": {
          "type": "number",
          "minimum": 12,
          "maximum": 40
        },
        "lyricFont": {
          "enum": [
            "serif",
            "sans"
          ]
        },
        "noteSize": {
          "type": "number",
          "minimum": 16,
          "maximum": 48
        },
        "titleSize": {
          "type": "number",
          "minimum": 20,
          "maximum": 72
        },
        "showBarNumbers": {
          "type": "boolean"
        },
        "showTrackNames": {
          "type": "boolean"
        },
        "chordDiagrams": {
          "type": "boolean"
        },
        "justifyLast": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "track": {
      "oneOf": [
        {
          "enum": [
            "numbered",
            "tab",
            "piano",
            "staff",
            "drums"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "numbered",
                "tab",
                "piano",
                "staff",
                "drums"
              ]
            },
            "name": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "frets",
                "cross",
                "strum"
              ]
            },
            "clef": {
              "enum": [
                "treble",
                "bass"
              ]
            },
            "tuning": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            },
            "lyrics": {
              "type": "boolean"
            },
            "showName": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
